        "@types/node": "^26.6.4",
        "bits-ui": "^2.19.5",
        "clsx": "^2.1.1",
        "jsdom": "^29.1.1",
        "svelte": "^5.57.2",
        "svelte-check": "^4.7.6",
        "tailwind-merge": "^3.7.0",
        "tailwind-variants": "^3.3.1",
        "tailwindcss": "^4.3.3",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
