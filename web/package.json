    "version": "0.0.1",
    "type": "module",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
